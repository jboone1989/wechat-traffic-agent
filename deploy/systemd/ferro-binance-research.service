[Unit]
Description=Ferro read-only Binance research observation (no trading or posting)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/content-agent/current
Environment=PYTHONPATH=/home/ubuntu/content-agent/current/src:/home/ubuntu/agent-runtime/current/src:/home/ubuntu/virtualbrain/current/src
Environment=CONTENT_APPLICATION_ROOT=/home/ubuntu/content-agent-state
ExecStart=/home/ubuntu/content-agent-venv-current/bin/python scripts/run_binance_research_collector.py
TimeoutStartSec=175
Nice=10
