[Unit]
Description=Ferro read-only market and news signals
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/content-agent/current
Environment=PYTHONPATH=/home/ubuntu/content-agent/current/src:/home/ubuntu/agent-runtime/current/src
Environment=CONTENT_APPLICATION_ROOT=/home/ubuntu/content-agent-state
EnvironmentFile=-/home/ubuntu/.config/ferro/market-signals.env
ExecStart=/home/ubuntu/content-agent-prod-venv-connectome-ffc4c726-c7d266d4-d2f4fd8c/bin/python scripts/run_market_signals_worker.py
TimeoutStartSec=55
