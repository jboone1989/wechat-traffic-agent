[Unit]
Description=Ferro Binance Square publication outbox (one task, no browser)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/content-agent/current
Environment=PYTHONPATH=/home/ubuntu/content-agent/current/src:/home/ubuntu/agent-runtime/current/src:/home/ubuntu/virtualbrain/current/src
Environment=CONTENT_APPLICATION_ROOT=/home/ubuntu/content-agent-state
EnvironmentFile=-/home/ubuntu/.config/ferro/binance-square.env
ExecStart=/home/ubuntu/content-agent-venv-current/bin/python scripts/run_square_distribution_worker.py
# X 双发经 omnipost 比单广场慢几秒，25s MCP 超时 + 余量
TimeoutStartSec=60
